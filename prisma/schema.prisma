generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum VideoKind {
  VIDEO
  SHORT_FILM
  TRAILER
  BEHIND_THE_SCENES
  INTERVIEW
}

enum ReportReason {
  COPYRIGHT
  INAPPROPRIATE
  SPAM
  HARASSMENT
  MISLEADING
}

enum ReportStatus {
  OPEN
  DISMISSED
  REMOVED
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  passwordHash  String?
  role          Role                @default(USER)
  profile       Profile?
  videos        Video[]
  comments      Comment[]
  videoLikes    VideoLike[]
  commentLikes  CommentLike[]
  subscriptions Subscription[]      @relation("Subscriber")
  subscribers   Subscription[]      @relation("Creator")
  playlists     Playlist[]
  watchHistory  WatchHistory[]
  watchProgress WatchProgress[]
  notifications Notification[]
  reports       Report[]
  views         VideoView[]
  analytics     CreatorAnalytics?
  searches      SearchHistory[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  username    String   @unique
  bio         String?  @db.VarChar(500)
  avatarUrl   String?
  bannerUrl   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  videos    Video[]
  movies    Movie[]
  createdAt DateTime    @default(now())
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  videos    Video[]  @relation("VideoGenres")
  movies    Movie[]  @relation("MovieGenres")
  createdAt DateTime @default(now())
}

model Video {
  id            String        @id @default(cuid())
  creatorId     String
  categoryId    String?
  title         String
  slug          String        @unique
  description   String        @db.Text
  kind          VideoKind     @default(VIDEO)
  visibility    Visibility    @default(PUBLIC)
  storageKey    String
  streamUrl     String?
  thumbnailUrl  String?
  durationSecs  Int           @default(0)
  language      String        @default("en")
  ageRestricted Boolean       @default(false)
  captions      Json?
  qualities     Json?
  publishedAt   DateTime?
  viewCount     Int           @default(0)
  likeCount     Int           @default(0)
  trendingScore Float         @default(0)
  creator       User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  genres        Genre[]       @relation("VideoGenres")
  comments      Comment[]
  likes         VideoLike[]
  playlistItems PlaylistVideo[]
  histories     WatchHistory[]
  progress      WatchProgress[]
  reports       Report[]
  views         VideoView[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([creatorId, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([visibility, trendingScore])
}

model Movie {
  id           String     @id @default(cuid())
  categoryId   String?
  title        String
  slug         String     @unique
  description  String     @db.Text
  posterUrl    String?
  backdropUrl  String?
  streamUrl    String?
  durationSecs Int        @default(0)
  releaseYear  Int
  rating       Float?
  director     String?
  cast         Json?
  featured     Boolean    @default(false)
  category     Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  genres       Genre[]    @relation("MovieGenres")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([categoryId, releaseYear])
  @@index([featured, releaseYear])
}

model Episode {
  id           String   @id @default(cuid())
  seriesSlug   String
  seasonNumber Int
  number       Int
  title        String
  slug         String   @unique
  description  String?  @db.Text
  thumbnailUrl String?
  streamUrl    String?
  durationSecs Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([seriesSlug, seasonNumber, number])
}

model Comment {
  id        String        @id @default(cuid())
  videoId   String
  authorId  String
  parentId  String?
  body      String        @db.VarChar(2000)
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([videoId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([videoId, userId])
  @@index([userId, createdAt])
}

model Subscription {
  id         String   @id @default(cuid())
  subscriberId String
  creatorId  String
  subscriber User     @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    User     @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([subscriberId, creatorId])
  @@index([creatorId, createdAt])
}

model Playlist {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?         @db.VarChar(500)
  isPublic    Boolean         @default(false)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos      PlaylistVideo[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, updatedAt])
}

model PlaylistVideo {
  playlistId String
  videoId    String
  position   Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([playlistId, videoId])
  @@unique([playlistId, position])
}

model WatchHistory {
  id             String   @id @default(cuid())
  userId         String
  videoId        String
  lastPosition   Int      @default(0)
  completionRate Float    @default(0)
  watchedAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, watchedAt])
}

model WatchProgress {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  positionSec Int      @default(0)
  durationSec Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?  @db.VarChar(500)
  href      String?
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  videoId    String
  reason     ReportReason
  detail     String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  video      Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
}

model VideoView {
  id        String   @id @default(cuid())
  videoId   String
  userId    String?
  watchedAt DateTime @default(now())
  watchSecs Int      @default(0)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([videoId, watchedAt])
  @@index([userId, watchedAt])
}

model CreatorAnalytics {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalViews     Int      @default(0)
  watchTimeSecs  Int      @default(0)
  subscriberCount Int     @default(0)
  likesCount     Int      @default(0)
  commentsCount  Int      @default(0)
  retention      Json?
  viewsByDay     Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String   @db.VarChar(255)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
